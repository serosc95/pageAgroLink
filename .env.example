# Copia este archivo a backend/.env y ajusta los valores.
#   cp .env.example backend/.env

# Servidor HTTP + WebSocket
PORT=3000
NODE_ENV=development
# Orígenes permitidos (separados por coma). Incluye el origen del frontend.
CORS_ORIGIN=http://localhost:3000

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=addcom
DB_USER=addcom
DB_PASSWORD=addcom_dev_password

# JWT
JWT_SECRET=cambia_este_secreto_por_una_cadena_larga_y_aleatoria
JWT_EXPIRES_IN=7d

# Límite de subida de fotos (bytes). 5 MB.
MAX_UPLOAD_BYTES=5242880
